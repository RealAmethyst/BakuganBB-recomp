+bool SDLInputDriver::EventWatch(void* userdata, SDL_Event* event) {
+  if (userdata && event && event->type >= SDL_EVENT_JOYSTICK_AXIS_MOTION &&
+      event->type < SDL_EVENT_FINGER_DOWN) {
+    auto* driver = static_cast<SDLInputDriver*>(userdata);
+    try {
+      driver->HandleEvent(*event);
+    } catch (...) {
+      // Never unwind through SDL's C callback or expose a partial input stream.
+      driver->modal_input_->Fail();
+    }
+  }
+  return false;
+}
