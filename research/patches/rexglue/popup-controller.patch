+namespace rex::ui {
+
+// Value-only bridge between driver event threads and the drawing thread.
+// Device keys are the driver's connection instance IDs, not guest user indices.
+class ModalGamepadInput : public std::enable_shared_from_this<ModalGamepadInput> {
+ public:
+  enum Button : uint8_t { None = 0, Left = 1, Right = 2, Confirm = 4 };
+  struct Edge {
+    Button button;
+    bool down;
+  };
+  struct Frame {
+    bool reset;
+    bool active;
+    std::optional<Edge> edge;
+  };
+  struct GuestState {
+    bool suppress;
+    uint16_t buttons;
+  };
+
+  class Capture {
+   public:
+    ~Capture() { Release(); }
+    uint64_t id() const { return id_.load(); }
+    void Release() {
+      if (const uint64_t id = id_.exchange(0))
+        owner_->Release(id);
+    }
+
+   private:
+    friend class ModalGamepadInput;
+    explicit Capture(std::shared_ptr<ModalGamepadInput> owner) : owner_(std::move(owner)) {}
+    std::shared_ptr<ModalGamepadInput> owner_;
+    std::atomic<uint64_t> id_{0};
+  };
+
+  std::shared_ptr<Capture> RequestCapture() {
+    auto capture = std::shared_ptr<Capture>(new Capture(shared_from_this()));
+    std::lock_guard<std::mutex> lock(mutex_);
+    const uint64_t id = next_id_;
+    captures_.push_back(id);
+    ++next_id_;
+    capture->id_ = id;
+    for (auto& [key, device] : devices_)
+      for (size_t bit = 0; bit < 16; ++bit) {
+        if (device.press_sequence[bit]) {
+          device.guest_blocked |= uint16_t(1u << bit);
+          device.block_sequence[bit] = device.press_sequence[bit];
+        }
+      }
+    ResetUiLocked();
+    return capture;
+  }
+
+  // Allocation failure in the driver must not expose a partial input stream.
+  // Recovery requires recreating the channel with the window.
+  void Fail() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    failed_ = true;
+    ResetUiLocked();
+  }
+
+  bool IsCaptured() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return !captures_.empty();
+  }
+
+  void SetFocus(bool focused) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (focused_ != focused) {
+      focused_ = focused;
+      ResetUiLocked();
+    }
+  }
+
+  // Drawing thread reports the actual focused native message popup, or zero.
+  void SetTarget(uint64_t target) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (target_ != target) {
+      target_ = target;
+      ResetUiLocked();
+    }
+  }
+
+  // Publish initial state only after the owning driver has opened the device.
+  // Held buttons on connection must be released before controlling a popup.
+  void Connect(uint64_t id, uint16_t native_down, uint8_t navigation_down, uint64_t sequence) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto& device = devices_[id];
+    device.ready = true;
+    device.native_down = native_down;
+    device.navigation_down = navigation_down;
+    device.ui_blocked = navigation_down;
+    for (size_t bit = 0; bit < 16; ++bit) {
+      if (native_down & (1u << bit)) {
+        device.press_sequence[bit] = std::max(device.press_sequence[bit], sequence);
+        if (!captures_.empty()) {
+          device.guest_blocked |= uint16_t(1u << bit);
+          device.block_sequence[bit] = device.press_sequence[bit];
+        }
+      }
+    }
+    UpdateUiLocked();
+  }
+
+  void Disconnect(uint64_t id) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    devices_.erase(id);
+    ResetUiLocked();
+  }
+
+  // The raw watch provides edges before SDL's global queue can discard them.
+  // This deliberately never clears guest_blocked on a raw release.
+  void Publish(uint64_t id, uint16_t native_button, Button navigation, bool down,
+               uint64_t sequence) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto& device = devices_[id];
+    if (down) {
+      device.native_down |= native_button;
+      device.navigation_down |= navigation;
+      for (size_t bit = 0; bit < 16; ++bit) {
+        if (native_button & (1u << bit)) {
+          device.press_sequence[bit] = sequence;
+          if (!captures_.empty()) {
+            device.guest_blocked |= uint16_t(1u << bit);
+            device.block_sequence[bit] = sequence;
+          }
+        }
+      }
+    } else {
+      device.native_down &= ~native_button;
+      device.navigation_down &= ~navigation;
+      device.ui_blocked &= ~navigation;
+      for (size_t bit = 0; bit < 16; ++bit)
+        if (native_button & (1u << bit))
+          device.release_sequence[bit] = sequence;
+    }
+    UpdateUiLocked();
+  }
+
+  // Use only fully drained driver state. Clearing quarantine from raw watch
+  // state can expose an older cached press before its release is drained.
+  GuestState FilterGuest(uint64_t id, uint16_t drained_buttons, uint64_t drained_sequence) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    auto found = devices_.find(id);
+    if (failed_ || found == devices_.end() || !found->second.ready)
+      return {true, 0};
+    auto& device = found->second;
+    if (!captures_.empty())
+      return {true, 0};
+    for (size_t bit = 0; bit < 16; ++bit) {
+      if (device.release_sequence[bit] > device.block_sequence[bit] &&
+          device.release_sequence[bit] <= drained_sequence) {
+        device.guest_blocked &= ~uint16_t(1u << bit);
+      }
+    }
+    return {false, uint16_t(drained_buttons & ~device.guest_blocked)};
+  }
+
+  // At most one edge per frame avoids leaving later activation presses in
+  // ImGui's trickled event queue when the first activation closes a popup.
+  Frame TakeFrame() {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Frame frame{reset_, ActiveLocked(), std::nullopt};
+    reset_ = false;
+    if (!frame.reset && frame.active && count_) {
+      frame.edge = edges_[head_];
+      head_ = (head_ + 1) % edges_.size();
+      --count_;
+    }
+    return frame;
+  }
+
+  uint64_t overflow_count() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return overflows_;
+  }
+
+ private:
+  struct Device {
+    uint16_t native_down = 0;
+    uint16_t guest_blocked = 0;
+    std::array<uint64_t, 16> press_sequence{};
+    std::array<uint64_t, 16> release_sequence{};
+    std::array<uint64_t, 16> block_sequence{};
+    uint8_t navigation_down = 0;
+    uint8_t ui_blocked = 0;
+    bool ready = false;
+  };
+
+  bool ActiveLocked() const {
+    return !failed_ && focused_ && target_ && !captures_.empty() && target_ == captures_.back();
+  }
+
+  void Release(uint64_t id) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto found = std::find(captures_.begin(), captures_.end(), id);
+    if (found == captures_.end())
+      return;
+    captures_.erase(found);
+    for (auto& [key, device] : devices_)
+      for (size_t bit = 0; bit < 16; ++bit) {
+        if (device.native_down & (1u << bit)) {
+          device.guest_blocked |= uint16_t(1u << bit);
+          device.block_sequence[bit] = device.press_sequence[bit];
+        }
+      }
+    ResetUiLocked();
+  }
+
+  void ResetUiLocked() {
+    for (auto& [key, device] : devices_)
+      device.ui_blocked |= device.navigation_down;
+    head_ = count_ = 0;
+    aggregate_ = 0;
+    reset_ = true;
+  }
+
+  void UpdateUiLocked() {
+    if (!ActiveLocked())
+      return;
+    uint8_t next = 0;
+    for (const auto& [key, device] : devices_)
+      if (device.ready)
+        next |= device.navigation_down & ~device.ui_blocked;
+    for (Button button : {Left, Right, Confirm}) {
+      if ((next & button) == (aggregate_ & button))
+        continue;
+      if (count_ == edges_.size()) {
+        // Do not deliver a partial edge stream. Release and require fresh input.
+        ++overflows_;
+        ResetUiLocked();
+        return;
+      }
+      edges_[(head_ + count_) % edges_.size()] = {button, (next & button) != 0};
+      ++count_;
+    }
+    aggregate_ = next;
+  }
+
+  mutable std::mutex mutex_;
+  std::unordered_map<uint64_t, Device> devices_;
+  std::vector<uint64_t> captures_;
+  uint64_t next_id_ = 1;
+  uint64_t target_ = 0;
+  bool focused_ = false;
+  bool failed_ = false;
+  bool reset_ = true;
+  uint8_t aggregate_ = 0;
+  std::array<Edge, 128> edges_{};
+  size_t head_ = 0;
+  size_t count_ = 0;
+  uint64_t overflows_ = 0;
+};
+
+}  // namespace rex::ui
