+// Clamp the final deadline, not the offset before adding the destination epoch.
+inline hundrednanoseconds ConvertClockOffset(hundrednanoseconds base, hundrednanoseconds offset,
+                                             double scalar, bool guest_to_host) {
+  if (scalar == 1.0) {
+    return AddClockOffset(base, offset);
+  }
+  long double ticks = static_cast<long double>(offset.count());
+  ticks = std::floor(guest_to_host ? ticks / scalar : ticks * scalar);
+  ticks += static_cast<long double>(base.count());
+  if (ticks >= static_cast<long double>(INT64_MAX)) {
+    return hundrednanoseconds::max();
+  }
+  if (ticks <= static_cast<long double>(INT64_MIN)) {
+    return hundrednanoseconds::min();
+  }
+  return hundrednanoseconds(static_cast<int64_t>(ticks));
+}
 
