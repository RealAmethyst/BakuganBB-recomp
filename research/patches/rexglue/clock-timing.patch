+inline hundrednanoseconds AddClockOffset(hundrednanoseconds base, hundrednanoseconds offset) {
+  if (offset.count() > 0 && base.count() > INT64_MAX - offset.count()) {
+    return hundrednanoseconds::max();
+  }
