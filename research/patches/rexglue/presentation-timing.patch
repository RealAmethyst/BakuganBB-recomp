+// These are guest GPU swap requests, not simulation updates or displayed frames.
+void RecordVulkanSwapTiming(bool skipped_placeholder) {
+  if (!REXCVAR_GET(vulkan_timing_diagnostics)) {
+    return;
+  }
+  static std::atomic<uint64_t> swaps{0}, skipped{0};
+  static std::atomic<int64_t> last_report_ns{0};
+  if (skipped_placeholder) {
+    skipped.fetch_add(1, std::memory_order_relaxed);
+  } else {
+    swaps.fetch_add(1, std::memory_order_relaxed);
+  }
+  const int64_t now_ns =
+      std::chrono::duration_cast<std::chrono::nanoseconds>(TimingClock::now().time_since_epoch())
+          .count();
+  int64_t previous = last_report_ns.load(std::memory_order_relaxed);
+  if (previous && now_ns - previous < 1000000000) {
+    return;
+  }
+  if (!last_report_ns.compare_exchange_strong(previous, now_ns, std::memory_order_relaxed) ||
+      !previous) {
+    return;
+  }
+  REXGPU_INFO("[Timing] Vulkan swap totals: host_ns={} interval_ns={} requests={} "
+              "skipped_placeholder={}",
+              now_ns, now_ns - previous, swaps.load(std::memory_order_relaxed),
+              skipped.load(std::memory_order_relaxed));
+}
