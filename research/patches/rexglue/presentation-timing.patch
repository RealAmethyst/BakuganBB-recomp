+using TimingClock = std::chrono::steady_clock;
+
+// Diagnostic counters are cumulative across presenters in this process. Queue
+// acceptance is not a measurement of physical display scanout.
+void RecordVulkanQueueTiming(bool present, VkResult result, TimingClock::duration elapsed) {
+  if (!REXCVAR_GET(vulkan_timing_diagnostics)) {
+    return;
+  }
+  static std::atomic<uint64_t> acquire_calls{0}, acquire_ns{0}, acquire_outdated{0};
+  static std::atomic<uint64_t> present_calls{0}, present_ns{0}, present_outdated{0};
+  static std::atomic<uint64_t> accepted{0}, suboptimal{0};
+  static std::atomic<int64_t> last_report_ns{0};
+  const uint64_t elapsed_ns = static_cast<uint64_t>(
+      std::chrono::duration_cast<std::chrono::nanoseconds>(elapsed).count());
+  const bool outdated = result == VK_ERROR_OUT_OF_DATE_KHR || result == VK_ERROR_SURFACE_LOST_KHR ||
+                        result == VK_ERROR_FULL_SCREEN_EXCLUSIVE_MODE_LOST_EXT;
+  if (present) {
+    present_calls.fetch_add(1, std::memory_order_relaxed);
+    present_ns.fetch_add(elapsed_ns, std::memory_order_relaxed);
+    if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR) {
+      accepted.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (result == VK_SUBOPTIMAL_KHR) {
+      suboptimal.fetch_add(1, std::memory_order_relaxed);
+    }
+    if (outdated) {
+      present_outdated.fetch_add(1, std::memory_order_relaxed);
+    }
+  } else {
+    acquire_calls.fetch_add(1, std::memory_order_relaxed);
+    acquire_ns.fetch_add(elapsed_ns, std::memory_order_relaxed);
+    if (outdated) {
+      acquire_outdated.fetch_add(1, std::memory_order_relaxed);
+    }
+  }
+  const int64_t now_ns =
+      std::chrono::duration_cast<std::chrono::nanoseconds>(TimingClock::now().time_since_epoch())
+          .count();
+  int64_t previous = last_report_ns.load(std::memory_order_relaxed);
+  if (previous && now_ns - previous < 1000000000) {
+    return;
+  }
+  if (!last_report_ns.compare_exchange_strong(previous, now_ns, std::memory_order_relaxed) ||
+      !previous) {
+    return;
+  }
+  REXLOG_INFO(
+      "[Timing] Vulkan queue totals: host_ns={} interval_ns={} acquire_calls={} acquire_ns={} "
+      "acquire_outdated={} present_calls={} present_ns={} accepted={} suboptimal={} "
+      "present_outdated={}",
+      now_ns, now_ns - previous, acquire_calls.load(std::memory_order_relaxed),
+      acquire_ns.load(std::memory_order_relaxed), acquire_outdated.load(std::memory_order_relaxed),
+      present_calls.load(std::memory_order_relaxed), present_ns.load(std::memory_order_relaxed),
+      accepted.load(std::memory_order_relaxed), suboptimal.load(std::memory_order_relaxed),
+      present_outdated.load(std::memory_order_relaxed));
+}
+}  // namespace
 
