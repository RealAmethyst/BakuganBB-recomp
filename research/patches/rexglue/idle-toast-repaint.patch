+std::function<void()> ImGuiDrawer::CreateRepaintRequest(std::weak_ptr<void> dialog_lifetime) {
+  auto* context = &window_->app_context();
+  std::weak_ptr<RepaintState> drawer_lifetime = repaint_state_;
+  return [context, drawer_lifetime, dialog_lifetime]() {
+    context->CallInUIThreadDeferred([drawer_lifetime, dialog_lifetime]() {
+      auto state = drawer_lifetime.lock();
+      if (!state || dialog_lifetime.expired()) {
+        return;
+      }
+      auto* presenter = state->drawer->presenter_;
+      if (presenter) {
+        presenter->RequestUIPaintFromUIThread();
+      }
+    });
+  };
+}
