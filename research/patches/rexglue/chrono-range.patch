+
+TEST_CASE("system conversion preserves the absolute NT tick range", "[chrono]") {
+  using namespace std::chrono;
+  using rex::chrono::hundrednanoseconds;
+  constexpr auto max_ticks = std::numeric_limits<int64_t>::max();
+  constexpr auto first = WinSystemClock::to_sys(WinSystemClock::from_file_time(0));
+  static_assert(std::is_same_v<typename decltype(first)::duration, hundrednanoseconds>);
+  STATIC_REQUIRE(first.time_since_epoch().count() == -116444736000000000LL);
+  constexpr auto last = WinSystemClock::to_sys(WinSystemClock::from_file_time(max_ticks));
+  STATIC_REQUIRE(last.time_since_epoch().count() == 9106927300854775807LL);
+  for (uint64_t ft : {uint64_t{0}, uint64_t{1}, kFtUnixEpoch - 1, kFtUnixEpoch, kFtUnixEpoch + 1,
+                      uint64_t{max_ticks - 1}, uint64_t{max_ticks}}) {
+    CHECK(WinSystemClock::to_file_time(WinSystemClock::from_sys(
+              WinSystemClock::to_sys(WinSystemClock::from_file_time(ft)))) == ft);
+  }
+}
+
+TEST_CASE("system conversion accepts different source precisions", "[chrono]") {
+  using namespace std::chrono;
+  CHECK(WinSystemClock::to_file_time(WinSystemClock::from_sys(sys_seconds{seconds{-1}})) ==
+        kFtUnixEpoch - 10000000);
+  CHECK(WinSystemClock::to_file_time(WinSystemClock::from_sys(
+            sys_time<microseconds>{microseconds{1}})) == kFtUnixEpoch + 10);
+  CHECK(WinSystemClock::to_file_time(
+            WinSystemClock::from_sys(sys_time<nanoseconds>{nanoseconds{199}})) == kFtUnixEpoch + 1);
+  CHECK(WinSystemClock::to_file_time(WinSystemClock::from_sys(
+            sys_time<nanoseconds>{nanoseconds{-199}})) == kFtUnixEpoch - 1);
+  CHECK(WinSystemClock::to_file_time(
+            WinSystemClock::from_sys(sys_time<nanoseconds>{nanoseconds{-99}})) == kFtUnixEpoch);
+  CHECK(WinSystemClock::to_file_time(WinSystemClock::from_sys(system_clock::time_point{})) ==
+        kFtUnixEpoch);
+}
+
+TEST_CASE("calendar conversion covers dates beyond native nanoseconds", "[chrono]") {
+  // Gregorian day arithmetic gives these independent absolute NT millisecond values.
+  CHECK(recompose(9999, 12, 31, 23, 59, 59, 999) == 2650467743999990000ULL);
+  CHECK(recompose(30828, 9, 14, 2, 48, 5, 477) == 9223372036854770000ULL);
+  auto last = decompose(std::numeric_limits<int64_t>::max());
+  CHECK(last.year == 30828);
+  CHECK(last.month == 9);
+  CHECK(last.day == 14);
+  CHECK(last.hours == 2);
+  CHECK(last.minutes == 48);
+  CHECK(last.seconds == 5);
+  CHECK(last.milliseconds == 477);
+  CHECK(recompose(30828, 9, 14, 2, 48, 5, 478) == 0);
+  CHECK(recompose(32767, 12, 31, 0, 0, 0, 0) == 0);
+  CHECK(recompose(32768, 1, 1, 0, 0, 0, 0) == 0);
+  CHECK(recompose(1600, 12, 31, 23, 59, 59, 999) == 0);
+}
+
+TEST_CASE("Rtl time exports accept absolute bounds and preserve output on invalid fields",
+          "[chrono][kernel]") {
+  struct Sample {
+    std::array<uint16_t, 7> fields;
+    bool valid;
+    uint64_t expected;
+  };
+  const Sample samples[] = {
+      {{1601, 1, 1, 0, 0, 0, 0}, true, 0},
+      {{1970, 1, 1, 0, 0, 0, 0}, true, kFtUnixEpoch},
+      {{2000, 2, 29, 0, 0, 0, 0}, true, kFtLeapDay},
+      {{9999, 12, 31, 23, 59, 59, 999}, true, 2650467743999990000ULL},
+      {{30828, 9, 14, 2, 48, 5, 477}, true, 9223372036854770000ULL},
+      {{30828, 9, 14, 2, 48, 5, 478}, false, 0},
+      {{32767, 12, 31, 0, 0, 0, 0}, false, 0},
+      {{32768, 1, 1, 0, 0, 0, 0}, false, 0},
+      {{65535, 1, 1, 0, 0, 0, 0}, false, 0},
+      {{1600, 12, 31, 23, 59, 59, 999}, false, 0},
+      {{2001, 2, 29, 0, 0, 0, 0}, false, 0},
+      {{2000, 1, 1, 24, 0, 0, 0}, false, 0},
+      {{2000, 1, 1, 0, 0, 0, 1000}, false, 0},
+  };
+  for (const auto& sample : samples) {
+    CAPTURE(sample.fields);
+    alignas(16) std::array<uint8_t, 64> memory{};
+    for (size_t i = 0; i < sample.fields.size(); ++i) {
+      memory[16 + i * 2] = static_cast<uint8_t>(sample.fields[i] >> 8);
+      memory[17 + i * 2] = static_cast<uint8_t>(sample.fields[i]);
+    }
+    std::fill(memory.begin() + 40, memory.begin() + 48, 0xA5);
+    PPCContext context{};
+    context.r3.u32 = 16;
+    context.r4.u32 = 40;
+    __imp__RtlTimeFieldsToTime(context, memory.data());
+    CHECK(context.r3.u32 == static_cast<uint32_t>(sample.valid));
+    uint64_t result = 0;
+    for (size_t i = 40; i < 48; ++i) {
+      result = (result << 8) | memory[i];
+    }
+    CHECK(result == (sample.valid ? sample.expected : 0xA5A5A5A5A5A5A5A5ULL));
+    if (sample.valid) {
+      std::fill(memory.begin() + 16, memory.begin() + 32, 0);
+      context.r3.u32 = 40;
+      context.r4.u32 = 16;
+      __imp__RtlTimeToTimeFields(context, memory.data());
+      for (size_t i = 0; i < sample.fields.size(); ++i) {
+        CHECK(((uint16_t{memory[16 + i * 2]} << 8) | memory[17 + i * 2]) == sample.fields[i]);
+      }
+    }
+  }
+}
