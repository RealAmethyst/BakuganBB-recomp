--- /dev/null
+++ b/include/rex/ui/message_box_dialog.h
@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace rex::ui {
+
+struct MessageBoxDialogEvent {
+  enum class Kind { Opened, Focused, Closed };
+
+  Kind kind;
+  uint64_t id = 0;
+  std::string title;
+  std::string description;
+  // Visible button caption; empty for lifecycle events.
+  std::string label;
+  // One-based actual focused button, or zero for lifecycle events.
+  uint32_t position = 0;
+  uint32_t total = 0;
+};
+
+using MessageBoxDialogObserver = std::function<void(const MessageBoxDialogEvent&)>;
+
+// Install before runtime threads start; replace or clear only after they stop.
+// Called synchronously on the dialog UI thread. Copy any event data retained
+// beyond the callback. Observers must not reenter UI drawing or alter dialogs.
+// Exceptions are caught so observation cannot prevent guest completion.
+void SetMessageBoxDialogObserver(MessageBoxDialogObserver observer);
+
+}  // namespace rex::ui
