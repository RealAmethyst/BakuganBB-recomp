 #include <vector>
 
 namespace {
+constexpr int kCallTimeoutMs = 500;
+constexpr auto kCallFlags = Gio::DBus::CallFlags::NO_AUTO_START;
+
+Glib::RefPtr<Gio::DBus::Connection> connect_to_existing_session() {
+  const char *address = std::getenv("DBUS_SESSION_BUS_ADDRESS");
+  if (address == nullptr || !std::string_view(address).starts_with("unix:") ||
+      std::string_view(address).find(';') != std::string_view::npos) {
+    return {};
+  }
+  auto cancellable = Gio::Cancellable::create();
+  std::jthread deadline([cancellable](std::stop_token stop) {
+    std::mutex mutex;
+    std::condition_variable_any wake;
+    std::unique_lock lock(mutex);
+    wake.wait_for(lock, stop, std::chrono::milliseconds(kCallTimeoutMs),
+                  [] { return false; });
+    if (!stop.stop_requested())
+      cancellable->cancel();
+  });
+  return Gio::DBus::Connection::create_for_address_sync(
+      address, cancellable,
+      Gio::DBus::ConnectionFlags::AUTHENTICATION_CLIENT |
+          Gio::DBus::ConnectionFlags::MESSAGE_BUS_CONNECTION);
+}
