+      // ImGui window titles hide the identifier suffix beginning with ##.
+      event.title = title_.substr(0, title_.find("##"));
+      event.description = description_;
+      event.text = observed_text_;
+      event.cursor = cursor_;
+      event.selection_start = selection_start_;
+      event.selection_end = selection_end_;
+      event.cancelled = kind == ui::KeyboardDialogEvent::Kind::Closed && cancelled_;
+      event.capacity = guest_capacity_;
+      if (focused_item > 0) {
+        event.label = focused_item == 1 ? "OK" : "Cancel";
+        event.position = static_cast<uint32_t>(focused_item);
+        event.total = 2;
+      }
+      ui::keyboard_dialog_observer(event);
+    } catch (...) {
+      REXKRNL_ERROR("Keyboard dialog observer failed");
+    }
+  }
