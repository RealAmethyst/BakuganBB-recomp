+  static int CaptureTextState(ImGuiInputTextCallbackData* data) {
+    auto* dialog = static_cast<KeyboardInputDialog*>(data->UserData);
+    if (data->EventFlag == ImGuiInputTextFlags_CallbackResize) {
+      dialog->text_buffer_.resize(data->BufSize);
+      data->Buf = dialog->text_buffer_.data();
+      return 0;
+    }
+    std::string text(data->Buf, data->BufTextLen);
+    if (rex::string::to_utf16(text).size() >= dialog->guest_capacity_) {
+      // Reject the entire edit rather than dropping an existing suffix. The
+      // resize flag allows ImGui to present a complete paste for validation.
+      text = dialog->observed_text_;
+      std::memcpy(data->Buf, text.c_str(), text.size() + 1);
+      data->BufTextLen = static_cast<int>(text.size());
+      data->BufDirty = true;
+      data->CursorPos = dialog->has_snapshot_ ? dialog->cursor_ : data->BufTextLen;
+      data->SelectionStart = dialog->has_snapshot_ ? dialog->selection_start_ : data->CursorPos;
+      data->SelectionEnd = dialog->has_snapshot_ ? dialog->selection_end_ : data->CursorPos;
+    }
+    dialog->snapshot_changed_ =
+        dialog->has_snapshot_ &&
+        (dialog->observed_text_ != text || dialog->cursor_ != data->CursorPos ||
+         dialog->selection_start_ != data->SelectionStart ||
+         dialog->selection_end_ != data->SelectionEnd);
+    dialog->observed_text_ = std::move(text);
+    dialog->cursor_ = data->CursorPos;
+    dialog->selection_start_ = data->SelectionStart;
+    dialog->selection_end_ = data->SelectionEnd;
+    dialog->has_snapshot_ = true;
+    return 0;
+  }
