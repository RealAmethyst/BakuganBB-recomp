@@ -0,0 +1,41 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <functional>
+#include <string>
+
+namespace rex::ui {
+
+struct KeyboardDialogEvent {
+  enum class Kind { Opened, Focused, Edited, Closed };
+
+  Kind kind;
+  uint64_t id = 0;
+  std::string title;
+  std::string description;
+  std::string text;
+  // Empty for the text field, whose visible caption is empty.
+  std::string label;
+  // UTF-8 byte positions, or -1 before the input widget supplies a snapshot.
+  int cursor = -1;
+  int selection_start = -1;
+  int selection_end = -1;
+  bool cancelled = false;
+  // Guest UTF-16 buffer capacity, including its terminator.
+  size_t capacity = 0;
+  // One-based button position; both zero for the text field or lifecycle events.
+  uint32_t position = 0;
+  uint32_t total = 0;
+};
+
+using KeyboardDialogObserver = std::function<void(const KeyboardDialogEvent&)>;
+
+// Install before runtime threads start; replace or clear only after they stop.
+// Called synchronously from dialog drawing on the UI thread. The event and its
+// strings live only for the callback; copy any data retained beyond the call.
+// Observers must not reenter UI drawing or alter the dialog. Exceptions are
+// caught so optional observation cannot prevent guest dialog completion.
+void SetKeyboardDialogObserver(KeyboardDialogObserver observer);
+
+}  // namespace rex::ui
