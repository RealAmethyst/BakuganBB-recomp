+HostPresentationState Presenter::GetHostPresentationStateFromUIThread() const {
+  if (!window_ || !window_->app_context().IsInUIThread()) {
+    HostPresentationState state;
+    state.error = "Host presentation state requires an attached window and the UI thread";
+    return state;
+  }
+  auto state = host_presentation_state_;
+  state.supported = SupportsHostVSync();
+  return state;
+}
+
+DisplayChangeResult Presenter::RequestHostVSyncFromUIThread(bool enabled) {
+  if (!window_ || !window_->app_context().IsInUIThread()) {
+    return {false, false, "Host VSync requests require an attached window and the UI thread"};
+  }
+  auto state = GetHostPresentationStateFromUIThread();
+  if (!state.supported) {
+    return {false, false, "Host VSync is not supported by this presenter"};
+  }
+  if (state.has_applied_preference && !state.pending && state.applied_vsync_preference == enabled) {
+    host_presentation_state_.requested_vsync = enabled;
+    return {true, true, {}};
+  }
+  host_presentation_state_.requested_vsync = enabled;
+  host_presentation_state_.pending = true;
+  host_presentation_state_.error.clear();
+  if (surface_) {
+    RequestPaintOrConnectionRecoveryViaWindow(true);
+  }
+  // Painting consumes this request later, never while a UI drawer is running.
+  // No queued callback retains a raw Presenter or Window pointer.
+  return {true, false, {}};
+}
+
+void Presenter::ApplyPendingHostVSyncFromUIThread() {
+  assert_false(is_executing_ui_drawers_);
+  assert_false(is_in_ui_thread_paint_);
+  if (host_presentation_state_.pending && surface_) {
+    OnSurfaceResizeFromUIThread();
+  }
+}
