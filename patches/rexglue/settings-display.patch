+    return {true, false, "Window closed during resize request"};
+  }
+  OnDesiredLogicalSizeUpdate(width, height);
+  display_state_.requested_logical_width = width;
+  display_state_.requested_logical_height = height;
+  display_state_.size_pending = true;
+  return {true, false, {}};
+}
+
+void WindowSDL::RecordDisplaySize(int width, int height) {
+  if (width <= 0 || height <= 0) {
+    return;
+  }
+#if REX_PLATFORM_MAC
+  display_state_.logical_width = uint32_t(width);
+  display_state_.logical_height = uint32_t(height);
+#else
+  display_state_.logical_width = SizeToLogical(uint32_t(width));
+  display_state_.logical_height = SizeToLogical(uint32_t(height));
+#endif
+  if (display_state_.logical_width == display_state_.requested_logical_width &&
+      display_state_.logical_height == display_state_.requested_logical_height) {
+    display_state_.size_pending = false;
+  }
+}
+
+void WindowSDL::RecordDisplayEvent(const SDL_Event& event) {
+  if (event.type == SDL_EVENT_WINDOW_ENTER_FULLSCREEN ||
+      event.type == SDL_EVENT_WINDOW_LEAVE_FULLSCREEN) {
+    display_state_.fullscreen = event.type == SDL_EVENT_WINDOW_ENTER_FULLSCREEN;
+    if (display_state_.fullscreen == display_state_.requested_fullscreen) {
+      display_state_.fullscreen_pending = false;
+    }
+  } else if (event.type == SDL_EVENT_WINDOW_RESIZED) {
+    RecordDisplaySize(event.window.data1, event.window.data2);
+  }
+}
