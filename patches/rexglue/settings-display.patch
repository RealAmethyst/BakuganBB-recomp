+      (SDL_GetWindowFlags(sdl_window_) &
+       (SDL_WINDOW_FULLSCREEN | SDL_WINDOW_MAXIMIZED | SDL_WINDOW_MINIMIZED))) {
+    return {false, false, "Window size can only be applied to a restored window"};
+  }
+  if (!state.size_pending && state.logical_width == width && state.logical_height == height) {
+    OnDesiredLogicalSizeUpdate(width, height);
