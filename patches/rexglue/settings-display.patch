+    return reject("Defer window changes until painting has finished");
+  }
+  display_state_.fullscreen_error.clear();
+  if (!state.fullscreen_pending && state.fullscreen == fullscreen) {
+    OnFullscreenUpdate(fullscreen);
+    display_state_.requested_fullscreen = fullscreen;
+    return {true, true, {}};
