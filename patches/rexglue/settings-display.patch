@@ -0,0 +1,47 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+
+namespace rex::ui {
+
+// Acceptance is separate from application. An accepted asynchronous request
+// may remain pending or be constrained by the window system. No persistence is
+// performed by the display APIs.
+struct DisplayChangeResult {
+  bool accepted = false;
+  bool applied = false;
+  std::string error;
+};
+
+struct WindowDisplayState {
+  bool available = false;
+  bool fullscreen = false;
+  bool requested_fullscreen = false;
+  bool fullscreen_pending = false;
+  // Last checked fullscreen request error, including legacy SetFullscreen.
+  std::string fullscreen_error;
+  // Event-confirmed client size in the Window abstraction's logical units.
+  // Zero means unavailable. This is neither guest nor internal draw resolution.
+  uint32_t logical_width = 0;
+  uint32_t logical_height = 0;
+  uint32_t requested_logical_width = 0;
+  uint32_t requested_logical_height = 0;
+  bool size_pending = false;
+  std::string error;
+};
+
+enum class HostPresentMode { kUnknown, kImmediate, kMailbox, kFifoRelaxed, kFifo };
+
+struct HostPresentationState {
+  bool supported = false;
+  bool requested_vsync = false;
+  bool has_applied_preference = false;
+  bool applied_vsync_preference = false;
+  bool pending = false;
+  // A false preference may still select FIFO if other modes are unavailable.
+  HostPresentMode actual_mode = HostPresentMode::kUnknown;
+  std::string error;
+};
+
+}  // namespace rex::ui
