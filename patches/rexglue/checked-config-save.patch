+template <typename T>
+void InsertConfigInteger(toml::table& table, const std::string& name, std::string_view text) {
+  T value{};
+  auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), value);
+  if (error != std::errc() || end != text.data() + text.size()) {
+    throw std::runtime_error("Invalid integer for configuration flag: " + name);
+  }
+  if constexpr (std::is_unsigned_v<T>) {
+    if (value > uint64_t(INT64_MAX)) {
+      throw std::runtime_error("Configuration integer exceeds TOML range: " + name);
+    }
+  }
+  table.insert(name, int64_t(value));
+}
+
+toml::table ConfigValue(const FlagEntry& entry, std::string_view text) {
+  toml::table value;
+  switch (entry.type) {
+    case FlagType::Boolean:
+      if (text != "true" && text != "false") {
+        throw std::runtime_error("Invalid boolean for configuration flag: " + entry.name);
+      }
+      value.insert(entry.name, text == "true");
+      break;
+    case FlagType::Int32:
+      InsertConfigInteger<int32_t>(value, entry.name, text);
+      break;
+    case FlagType::Int64:
+      InsertConfigInteger<int64_t>(value, entry.name, text);
+      break;
+    case FlagType::Uint32:
+      InsertConfigInteger<uint32_t>(value, entry.name, text);
+      break;
+    case FlagType::Uint64:
+      InsertConfigInteger<uint64_t>(value, entry.name, text);
+      break;
+    case FlagType::Double: {
+      double number;
+      auto [end, error] = std::from_chars(text.data(), text.data() + text.size(), number);
+      if (error != std::errc() || end != text.data() + text.size() || !std::isfinite(number)) {
+        throw std::runtime_error("Invalid number for configuration flag: " + entry.name);
+      }
+      value.insert(entry.name, number);
+      break;
+    }
+    case FlagType::String:
+      value.insert(entry.name, text);
+      break;
+    case FlagType::Command:
+      throw std::runtime_error("Cannot persist a command: " + entry.name);
+  }
+  return value;
+}
+
+// No setters or change callbacks: this also accepts values pending a restart.
+ConfigSnapshot SnapshotConfig(const std::vector<ConfigSaveValue>* requested) {
+  std::lock_guard lock(GetRegistryMutex());
+  ConfigSnapshot snapshot;
+  auto add = [&](const FlagEntry& entry, const std::string& text) {
+    if (!ValidateConstraints(entry, text)) {
+      throw std::runtime_error("Invalid value for configuration flag: " + entry.name);
+    }
+    auto value = ConfigValue(entry, text);
+    auto defaults = ConfigValue(entry, entry.default_value);
+    snapshot.names.push_back(entry.name);
+    if (value != defaults) {
+      snapshot.overrides.insert_or_assign(entry.name, *value.get(entry.name));
+    } else {
+      snapshot.overrides.erase(entry.name);
+    }
+  };
+  if (requested) {
+    std::unordered_set<std::string> seen;
+    for (const auto& value : *requested) {
+      auto it = GetRegistryIndex().find(value.name);
+      if (it == GetRegistryIndex().end()) {
+        throw std::runtime_error("Unknown configuration flag: " + value.name);
+      }
+      if (!seen.insert(value.name).second) {
+        throw std::runtime_error("Duplicate configuration flag: " + value.name);
+      }
+      add(GetRegistryStorage()[it->second], value.value);
+    }
+  } else {
+    for (const auto& entry : GetRegistryStorage()) {
+      if (entry.type != FlagType::Command) {
+        add(entry, entry.getter());
+      }
+    }
+  }
+  return snapshot;
+}
