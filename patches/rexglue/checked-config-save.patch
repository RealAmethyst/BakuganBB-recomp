+ConfigSaveResult SaveConfigSnapshot(const std::filesystem::path& path,
+                                    const ConfigSnapshot& snapshot) {
+  // Registry snapshots are completed before this lock; never acquire the
+  // registry mutex while doing file I/O. Serializes in-process read/merge/write.
+  std::lock_guard lock(GetConfigSaveMutex());
+  std::error_code error;
+  auto status = std::filesystem::symlink_status(path, error);
+  if (error && error != std::errc::no_such_file_or_directory) {
+    throw std::system_error(error, "Inspect configuration destination");
+  }
+  bool exists = std::filesystem::exists(status);
+  if (exists && !std::filesystem::is_regular_file(status)) {
+    throw std::runtime_error("Configuration destination must be a regular file");
+  }
+  toml::table config;
+  if (exists) {
+    std::ifstream input(path, std::ios::binary);
+    if (!input) {
+      throw std::runtime_error("Cannot open existing configuration");
+    }
+    input.exceptions(std::ios::badbit);
+    config = toml::parse(input);
+  }
+  for (const auto& name : snapshot.names) {
+    if (config[name].is_table() && snapshot.overrides.contains(name)) {
+      throw std::runtime_error("Configuration flag collides with an existing table: " + name);
+    }
+  }
+  EraseConfigAliases(config, "", {snapshot.names.begin(), snapshot.names.end()});
+  for (const auto& [key, value] : snapshot.overrides) {
+    config.insert_or_assign(key, value);
+  }
+  std::ostringstream stream;
+  stream.exceptions(std::ios::badbit | std::ios::failbit);
+  stream << "# Auto-generated cvar configuration\n" << config << '\n';
+  std::string content = stream.str();
+  // Validate the complete serialization before creating any temporary file.
+  // This also rejects malformed UTF-8 in string values.
+  if (toml::parse(content) != config) {
+    throw std::runtime_error("Configuration values cannot be represented losslessly in TOML");
+  }
+  ConfigTemporaryFile temporary(path);
+  temporary.WriteAndClose(content, exists ? status.permissions() : std::filesystem::perms::unknown);
+  temporary.Replace(path);
+  return {true, {}};
+}
+
+ConfigSaveResult SaveConfigCheckedImpl(const std::filesystem::path& path,
+                                       const std::vector<ConfigSaveValue>* values) {
+  try {
+    auto snapshot = SnapshotConfig(values);
+    return SaveConfigSnapshot(path, snapshot);
+  } catch (const std::exception& error) {
+    return {false, error.what()};
+  }
+}
+
+}  // namespace
+
+ConfigSaveResult SaveConfigChecked(const std::filesystem::path& config_path,
+                                   const std::vector<ConfigSaveValue>& values) {
+  return SaveConfigCheckedImpl(config_path, &values);
+}
+
+ConfigSaveResult SaveConfigChecked(const std::filesystem::path& config_path) {
+  return SaveConfigCheckedImpl(config_path, nullptr);
+}
