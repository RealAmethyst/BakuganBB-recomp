+// Own only an exclusively-created sibling; never truncate the destination.
+class ConfigTemporaryFile {
+ public:
+  explicit ConfigTemporaryFile(const std::filesystem::path& destination) {
+    static std::atomic<uint64_t> sequence{0};
+    for (size_t attempt = 0; attempt < 100; ++attempt) {
+      path_ = destination;
+#if REX_PLATFORM_WIN32
+      path_ += ".tmp." + std::to_string(GetCurrentProcessId()) + "." +
+               std::to_string(sequence.fetch_add(1));
+      handle_ = CreateFileW(path_.c_str(), GENERIC_WRITE, 0, nullptr, CREATE_NEW,
+                            FILE_ATTRIBUTE_NORMAL, nullptr);
+      if (handle_ != INVALID_HANDLE_VALUE) {
+        return;
+      }
+      if (GetLastError() != ERROR_FILE_EXISTS && GetLastError() != ERROR_ALREADY_EXISTS) {
+        throw std::system_error(GetLastError(), std::system_category(), "Create config temporary");
+      }
+#else
+      path_ += ".tmp." + std::to_string(getpid()) + "." + std::to_string(sequence.fetch_add(1));
+      fd_ = open(path_.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_CLOEXEC, 0600);
+      if (fd_ >= 0) {
+        return;
+      }
+      if (errno != EEXIST) {
+        throw std::system_error(errno, std::generic_category(), "Create config temporary");
+      }
+#endif
+    }
+    throw std::runtime_error("Cannot create a unique configuration temporary file");
+  }
+
+  ConfigTemporaryFile(const ConfigTemporaryFile&) = delete;
+  ConfigTemporaryFile& operator=(const ConfigTemporaryFile&) = delete;
+
+  ~ConfigTemporaryFile() {
+#if REX_PLATFORM_WIN32
+    if (handle_ != INVALID_HANDLE_VALUE) {
+      CloseHandle(handle_);
+    }
+#else
+    if (fd_ >= 0) {
+      close(fd_);
+    }
+#endif
+    if (!path_.empty()) {
+      std::error_code ignored;
+      std::filesystem::remove(path_, ignored);
+    }
+  }
+
+  void WriteAndClose(std::string_view content, std::filesystem::perms permissions) {
+#if REX_PLATFORM_WIN32
+    (void)permissions;
+    while (!content.empty()) {
+      DWORD written = 0;
+      DWORD count = DWORD(std::min(content.size(), size_t(MAXDWORD)));
+      if (!WriteFile(handle_, content.data(), count, &written, nullptr)) {
+        throw std::system_error(GetLastError(), std::system_category(), "Write config temporary");
+      }
+      if (!written) {
+        throw std::runtime_error("No progress writing configuration temporary");
+      }
+      content.remove_prefix(written);
+    }
+    if (!FlushFileBuffers(handle_)) {
+      throw std::system_error(GetLastError(), std::system_category(), "Flush config temporary");
+    }
+    HANDLE handle = std::exchange(handle_, INVALID_HANDLE_VALUE);
+    if (!CloseHandle(handle)) {
+      throw std::system_error(GetLastError(), std::system_category(), "Close config temporary");
+    }
+#else
+    if (permissions != std::filesystem::perms::unknown &&
+        fchmod(fd_, mode_t(permissions) & 0777) != 0) {
+      throw std::system_error(errno, std::generic_category(), "Set config permissions");
+    }
+    while (!content.empty()) {
+      ssize_t written = write(fd_, content.data(), std::min(content.size(), size_t(SSIZE_MAX)));
+      if (written < 0) {
+        if (errno == EINTR) {
+          continue;
+        }
+        throw std::system_error(errno, std::generic_category(), "Write config temporary");
+      }
+      if (!written) {
+        throw std::runtime_error("No progress writing configuration temporary");
+      }
+      content.remove_prefix(size_t(written));
+    }
+    if (fsync(fd_) != 0) {
+      throw std::system_error(errno, std::generic_category(), "Flush config temporary");
+    }
+    int fd = std::exchange(fd_, -1);
+    if (close(fd) != 0) {
+      throw std::system_error(errno, std::generic_category(), "Close config temporary");
+    }
+#endif
+  }
+
+  void Replace(const std::filesystem::path& destination) {
+#if REX_PLATFORM_WIN32
+    if (!MoveFileExW(path_.c_str(), destination.c_str(),
+                     MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+      throw std::system_error(GetLastError(), std::system_category(), "Replace configuration");
+    }
+#else
+    if (rename(path_.c_str(), destination.c_str()) != 0) {
+      throw std::system_error(errno, std::generic_category(), "Replace configuration");
+    }
+#endif
+    path_.clear();
+  }
+
+ private:
+  std::filesystem::path path_;
+#if REX_PLATFORM_WIN32
+  HANDLE handle_ = INVALID_HANDLE_VALUE;
+#else
+  int fd_ = -1;
+#endif
+};
