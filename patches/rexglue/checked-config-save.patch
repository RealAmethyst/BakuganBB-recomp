+// Match ApplyTomlTable's flattening, including alternative underscore splits.
+void EraseConfigAliases(toml::table& table, const std::string& prefix,
+                        const std::unordered_set<std::string>& names) {
+  for (auto it = table.begin(); it != table.end();) {
+    std::string name =
+        prefix.empty() ? std::string(it->first) : prefix + "_" + std::string(it->first);
+    if (auto* child = it->second.as_table()) {
+      EraseConfigAliases(*child, name, names);
+      ++it;
+    } else if (names.contains(name)) {
+      it = table.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
