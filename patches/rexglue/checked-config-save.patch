+// A requested disk value, independent of the current runtime value. Values
+// must name registered non-command flags and pass their type and constraints.
+// Floating-point values must be finite.
+struct ConfigSaveValue {
+  std::string name;
+  std::string value;
+};
+
+struct ConfigSaveResult {
+  bool saved = false;
+  std::string error;
+};
+
+// Persist only the supplied values; unrelated TOML keys are retained. Defaults
+// erase all flat/nested aliases understood by LoadConfig. No setters, callbacks,
+// source priorities or restart markers are changed. The all-flags overload
+// snapshots registered values under the registry lock, then releases it for I/O.
+// Success means the snapshot was written, synced, closed and atomically replaced
+// the destination; it does not mean a runtime setting was accepted/applied. On
+// failure before replacement the original file is unchanged. Rejects symlinks,
+// nonregular files, invalid TOML and unrepresentable values. Comments/formatting
+// are not retained. Requires an existing parent directory and exclusive ownership
+// against external writers; callers serialize value changes and save requests.
+// Do not call from a cvar change callback. File data is synced before replacement;
+// directory-entry durability across power loss is not guaranteed.
+ConfigSaveResult SaveConfigChecked(const std::filesystem::path& config_path,
+                                   const std::vector<ConfigSaveValue>& values);
+ConfigSaveResult SaveConfigChecked(const std::filesystem::path& config_path);
+
+// Compatibility wrapper: logs checked-save failures; use the checked operation
+// when the caller must acknowledge persistence.
 void SaveConfig(const std::filesystem::path& config_path);
 
